config_version=5

[application]

config/name="Tavernfall"
config/icon="res://assets/tavernfall.png"
run/main_scene="res://ui/menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[autoload]

Game="*res://game.gd"

[rendering]

textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
environment/ssao/quality=1
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=40
environment/glow/upscale_mode=0
